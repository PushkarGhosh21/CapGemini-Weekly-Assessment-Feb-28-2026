<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:p="http://www.springframework.org/schema/p"
	xmlns:c="http://www.springframework.org/schema/c"
	xsi:schemaLocation="http://www.springframework.org/schema/beans 
	http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->	

	<bean name="employee1" class="com.capgemini.spring.Employee" autowire="byName"> 
	<property name="id" value="1234"></property>
	<property name="name" value="Rajesh"></property>
	<property name="email" value="Raj@gmail.com"></property>
	<property name="salary" value="300000"></property>
	
	
	</bean>
	<!-- Setter Injection -->
	<bean name="student" class="com.capgemini.spring.Student">
	<property name="id" value="100"></property>
	<property name="name" value="Subarna"></property>
	<property name="gender" value="Male"></property>
	<property name="marks" value="100"></property>
	</bean>
	
	<bean name="student1" class="com.capgemini.spring.Student">
	<constructor-arg value="102"></constructor-arg>
	<constructor-arg value="Pushkar Ghosh"></constructor-arg>
	<constructor-arg value="Male"></constructor-arg>
	<constructor-arg value="999"></constructor-arg>
	</bean>
	
		<bean name="employee" class="com.capgemini.spring.Employee"> 
	<property name="id" value="1212"></property>
	<property name="name" value="Heblu"></property>
	<property name="email" value="H@gmail.com"></property>
	<property name="salary" value="312340000"></property>
	<property name="student" ref="student1"></property>
	</bean>
	
	<bean name="string" class="java.lang.String">
	<constructor-arg value="Hello"></constructor-arg>
	</bean>
</beans>